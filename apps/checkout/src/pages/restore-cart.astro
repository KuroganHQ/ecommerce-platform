---
import { t } from "@platform/storefront-sdk/format";
import Checkout from "../layouts/Checkout.astro";
import { checkoutApi, grantPageToken, shopUrl } from "../lib/api";
import { Button } from "../ui.tsx";

// Abandoned-cart reminder link (WP19). A GET never consumes the capability, so mail scanners
// can open this page safely; the button's POST restores the cart once.
const shop = await checkoutApi(Astro.request).shop();
const token = Astro.url.searchParams.get("token") ?? "";
const pageToken = grantPageToken(Astro.request);
const error = Astro.url.searchParams.get("error") === "1";
const valid = pageToken
  ? Astro.url.searchParams.get("link") !== "invalid"
  : /^[0-9a-f]{64}$/.test(token) && !Astro.url.searchParams.has("invalid");
const m = shop?.messages ?? {};
---

<Checkout
  title={t(m, "flows.restore_title")}
  shopName={shop?.name ?? ""}
  shopUrl={shopUrl(Astro.url)}
  lang={shop?.locale ?? "cs"}
  accountLabel={t(m, "account.nav")}
  accountUrl={shop?.account_url}
  platformLinks={!pageToken}
>
  <div class="grid max-w-xl gap-4">
    <h1 class="font-display text-2xl font-bold">{t(m, "flows.restore_title")}</h1>
    {
      valid ? (
        <form
          method="post"
          action={pageToken ? "/restore-cart" : "/_p/flows/restore-cart"}
          class="grid justify-items-start gap-4"
        >
          <p>{t(m, "flows.restore_intro")}</p>
          {error && (
            <p role="alert" class="font-medium text-error-700">
              {t(m, "flows.error")}
            </p>
          )}
          {pageToken ? (
            <input type="hidden" name="_pt" value={pageToken} />
          ) : (
            <input type="hidden" name="token" value={token} />
          )}
          <Button type="submit" variant="primary">
            {t(m, "flows.restore_button")}
          </Button>
        </form>
      ) : (
        <p role="alert">{t(m, "flows.restore_invalid")}</p>
      )
    }
    <a href={shopUrl(Astro.url)} class="text-sm text-identity-ink underline">{t(m, "nl.back")}</a>
  </div>
</Checkout>
