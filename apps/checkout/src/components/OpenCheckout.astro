---
import type { CheckoutView, ShopModel } from "@platform/storefront-sdk/types";
import CheckoutForm from "../islands/CheckoutForm";
import { messages } from "../lib/api";

interface Props {
  shop: ShopModel | null;
  view: CheckoutView;
  shopUrl: string;
}
const { shop, view, shopUrl } = Astro.props;
const m = shop?.messages ?? {};
---

<CheckoutForm
  client:load
  mode="isolated"
  m={messages(
    m,
    "checkout.",
    "cart.",
    "address.",
    "account.email",
    "account.invalid_email",
    "legal.terms",
    "consent.email_marketing_hint",
  )}
  locale={shop?.locale ?? "cs"}
  initial={view}
  shopUrl={shopUrl}
/>
